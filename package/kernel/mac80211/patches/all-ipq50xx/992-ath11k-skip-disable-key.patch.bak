 };
 
 struct ath11k_sta {
--- a/drivers/net/wireless/ath/ath11k/mac.c
+++ b/drivers/net/wireless/ath/ath11k/mac.c
@@ -2960,6 +2960,36 @@ static void ath11k_mac_op_bss_info_changed(struct ieee80211_hw *hw,
 	mutex_unlock(&ar->conf_mutex);
 }
 
+static int ath11k_set_group_keys(struct ath11k_vif *arvif)
+{
+	struct ath11k *ar = arvif->ar;
+	struct ath11k_base *ab = ar->ab;
+	const u8 *addr = arvif->bssid;
+	int i, ret, first_errno = 0;
+	struct ath11k_peer *peer;
+
+	spin_lock_bh(&ab->base_lock);
+	peer = ath11k_peer_find(ab, arvif->vdev_id, addr);
+	spin_unlock_bh(&ab->base_lock);
+
+	if (!peer)
+		return -ENOENT;
+
+	for (i = 0; i < ARRAY_SIZE(peer->keys); i++) {
+		struct ieee80211_key_conf *key = peer->keys[i];
+
+		if (!key || (key->flags & IEEE80211_KEY_FLAG_PAIRWISE))
+			continue;
+
+		ret = ath11k_install_key(arvif, key, SET_KEY, addr, WMI_KEY_GROUP);
+		if (ret < 0 && first_errno == 0)
+			first_errno = ret;
+
+		if (ret < 0)
+			ath11k_warn(ab, "failed to set group key of idx %d for vdev %d: %d\n", i, arvif->vdev_id, ret);
+	}
+
+	return first_errno;
+}
+
 static int ath11k_mac_op_set_key(struct ieee80211_hw *hw, enum set_key_cmd cmd,
 				 struct ieee80211_vif *vif, struct ieee80211_sta *sta,
 				 struct ieee80211_key_conf *key)
@@ -2969,6 +2999,7 @@ static int ath11k_mac_op_set_key(struct ieee80211_hw *hw, enum set_key_cmd cmd,
 	struct ath11k *ar = hw->priv;
 	struct ath11k_base *ab = ar->ab;
 	struct ath11k_sta *arsta;
+	bool is_ap_with_no_sta;
 	int ret = 0;
 	u8 peer_addr[ETH_ALEN];
 	u32 flags = 0;
@@ -3000,8 +3031,8 @@ static int ath11k_mac_op_set_key(struct ieee80211_hw *hw, enum set_key_cmd cmd,
 	}
 
 	ret = ath11k_dp_peer_rx_pn_replay_config(arvif, peer_addr, cmd, key);
 	if (ret) {
 		ath11k_warn(ab, "failed to offload PN replay detection %d\n", ret);
 		goto exit;
 	}
 
@@ -3045,6 +3076,8 @@ static void ath11k_mac_op_sta_rc_update(struct ieee80211_hw *hw,
 
 	arsta = (struct ath11k_sta *)sta->drv_priv;
 	ar->num_stations++;
+	arvif->num_stations++;
 
 	if (ar->num_stations == 1) {
 		ieee80211_queue_delayed_work(ar->hw, &ar->tx_ba_monitor,
@@ -3070,6 +3103,8 @@ static void ath11k_mac_op_sta_rc_update(struct ieee80211_hw *hw,
 	ar->num_stations--;
+	if (arvif->num_stations > 0)
+		arvif->num_stations--;
 
 	if (ar->num_stations == 0) {
 		cancel_delayed_work_sync(&ar->tx_ba_monitor);
@@ -3520,6 +3555,15 @@ static int ath11k_mac_station_add(struct ath11k *ar,
 		goto dec_num_station;
 	}
 
+	/* 当第一个站点接入，且标记了需重装群组密钥时执行 */
+	if (arvif->num_stations == 1 && arvif->reinstall_group_keys) {
+		ret = ath11k_set_group_keys(arvif);
+		if (ret)
+			goto dec_num_station;
+		arvif->reinstall_group_keys = false;
+	}
+
 	arsta->rx_stats = kzalloc(sizeof(struct ath11k_rx_stats), GFP_KERNEL);
 	if (!arsta->rx_stats) {
 		ret = -ENOMEM;
